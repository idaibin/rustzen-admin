[Unit]
Description=Rustzen Insights Worker
After=network.target rz-recovery.service
PartOf=rz-full.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
UMask=0027
User=rz-insights
Group=rz-insights
EnvironmentFile=/opt/rz/config/rz.env
ExecCondition=/usr/bin/test ! -e /opt/rz/data/recovery-blocked
ExecStart=/opt/rz/current/bin/rz-insights serve
WorkingDirectory=/opt/rz
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/rz/data/db/insights /opt/rz/logs/insights

[Install]
WantedBy=rz-full.service
